PORT=3000
DATABASE_URL="file:./dev.db"

# Modo de operação do WhatsApp: "baileys" (QR Code direto no terminal) ou "evolution" (Webhook REST)
WHATSAPP_PROVIDER="baileys"

# Controle de acesso exclusivo para Testers
# Quando STRICT_TESTER_ONLY="true", apenas os números listados em TESTER_PHONES (ou cadastrados como testers no banco) podem usar o bot.
# Qualquer mensagem de outro número será ignorada silenciosamente.
STRICT_TESTER_ONLY="true"
TESTER_PHONES="5511999999999,5521988888888"

# Chave para gerenciar testers via endpoint local (/admin/testers)
ADMIN_API_KEY="pitt-admin-secret"

# Configurações opcionais para Evolution API (quando WHATSAPP_PROVIDER="evolution")
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="sua-api-key"
EVOLUTION_INSTANCE="pitt-ai"
